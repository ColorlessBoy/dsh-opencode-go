{
  "name": "dsh-opencode-go",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for OpenCode Go: live model routes with protocol split and the required session header, plus a key-pool usage widget with click-to-switch.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlessBoy/dsh-opencode-go.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "runtime",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "generate-catalog": "node scripts/generate-catalog.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6"
  }
}
